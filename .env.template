DB_DRIVER={ODBC Driver 18 for SQL Server}
DB_SERVER=seu_servidor_sql\\sua_instancia
DB_DATABASE=seu_banco_de_dados
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
# Se precisar de TrustServerCertificate=yes, descomente a linha abaixo:
# DB_TRUST_CERT=1

# -------------------------------------------------------------
# 3C Plus – Credenciais e Configuração (Config First)
# Preencha com os dados reais do seu tenant 3C Plus.
# -------------------------------------------------------------

# URL base do tenant (sem /api/v1). Ex.: https://acme.3c.plus
THREECPLUS_BASE_URL=

# Credenciais de autenticação
THREECPLUS_USERNAME=
THREECPLUS_PASSWORD=

# Identificação da empresa (opcional; depende do tenant)
THREECPLUS_COMPANY_ID=
THREECPLUS_COMPANY_DOMAIN=

# Campanhas alvo (nomes separados por vírgula)
# Exemplo com todas as campanhas disponíveis no 3C Plus:
# THREECPLUS_TARGET_CAMPAIGNS=Tenda, Cyrela - Pré Empreendimentos, Deva Veículos, Longitude, RSF Judicial, Campanha teste, Direcional Extrajudicial, Direcional Judicial, VIC Extrajudicial, VIC Judicial, EMCCAMP Extrajudicial, EMCCAMP Judicial, Tabelionato, Cyrela Extrajudicial, Cyrela Judicial, Sobrosa Mello, Movida Extrajudicial, Movida Judicial, Foco Aluguel, Arbore Extrajudicial, Arbore Judicial, LCM, Vila Brasil Extrajudicial, CredAluga, Jerônimo, Sempre Editora, São José
THREECPLUS_TARGET_CAMPAIGNS=

# Token de API (opcional). Se informado, pode ser usado diretamente.
# ATENÇÃO: mantenha o token alinhado ao tenant configurado em THREECPLUS_BASE_URL
THREECPLUS_API_TOKEN=

# Logs (opcional)
LOG_DIR=logs
LOG_LEVEL=INFO